# Firebase — điền từ Project settings → Your apps (Web app)
# Nếu để trống, game tự chạy ở chế độ LOCAL (nhiều tab cùng máy, không cần mạng).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Nano Banana (Gemini 2.5 Flash Image) — chỉ dùng khi tạo ảnh, không cần cho game.
# Lấy key miễn phí: https://aistudio.google.com/apikey
# Thêm vào .env.local (đã gitignore), KHÔNG commit key.
GEMINI_API_KEY=
